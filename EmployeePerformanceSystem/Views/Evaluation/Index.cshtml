@model List<Indamin.Performance.Controllers.EvaluationController.Row>
@{ViewData["Title"]="ارزیابی‌های من";}
<div class="d-flex justify-content-between mb-3"><div><h2>ارزیابی‌های من</h2><div class="text-muted">فقط کارکنان زیرمجموعه سلسله‌مراتبی شما نمایش داده می‌شوند.</div></div></div>
<div class="cardx"><div class="row g-2 mb-3"><div class="col-md-5"><input class="form-control" placeholder="جستجو نام یا کد پرسنلی"></div><div class="col-md-3"><select class="form-select"><option>همه وضعیت‌ها</option><option>تکمیل شده</option><option>در انتظار ارزیابی</option></select></div><div class="col-md-2"><button class="btn btn-main w-100">فیلتر</button></div></div><div class="table-responsive"><table class="table"><thead><tr><th>کد پرسنلی</th><th>نام و نام خانوادگی</th><th>رده پستی</th><th>واحد</th><th>عملیات</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.PersonnelNo</td><td>@e.Name</td><td>@e.Position</td><td>@e.Unit</td><td><a class="btn btn-sm btn-main" href="/Evaluation/Form/@e.Id">ارزیابی / مشاهده</a></td></tr>}</tbody></table></div></div>