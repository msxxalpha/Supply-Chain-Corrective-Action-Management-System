@model List<Indamin.Performance.Controllers.EvaluationController.Row>
@{ViewData["Title"]="ارزیابی‌های من";}
<div class="d-flex justify-content-between mb-3"><div><h2>ارزیابی‌های من</h2><div class="text-muted">تمام کارکنان فعال در زیرمجموعه سازمانی شما نمایش داده می‌شوند؛ ارزیاب بالادست می‌تواند ارزیابی ارزیابان و کارکنان زیرمجموعه آنان را نیز بازنگری و اصلاح کند.</div></div><a class="btn btn-success" href="/Evaluation/ExportMyList">خروجی Excel</a></div>
<div class="cardx"><div class="row g-2 mb-3"><div class="col-md-6"><input class="form-control" data-table-filter="#evalTable" placeholder="فیلتر سریع نام، کد، رده یا واحد"></div></div><div class="table-responsive"><table id="evalTable" class="table"><thead><tr><th>کد پرسنلی</th><th>نام و نام خانوادگی</th><th>رده پستی</th><th>واحد</th><th>نوع</th><th>عملیات</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.PersonnelNo</td><td>@e.Name</td><td>@e.Position</td><td>@e.Unit</td><td>@(e.IsEvaluator ? "ارزیاب" : "کارمند")</td><td><a class="btn btn-sm btn-main" href="/Evaluation/Form/@e.Id">ارزیابی / مشاهده</a></td></tr>}</tbody></table></div></div>