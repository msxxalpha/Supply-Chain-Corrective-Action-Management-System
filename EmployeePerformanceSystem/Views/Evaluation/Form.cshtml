@model Indamin.Performance.Controllers.EvaluationController.FormVm
@{ViewData["Title"]="فرم ارزیابی";var editable=DateTime.Now>=Model.Period.StartAt&&DateTime.Now<=Model.Period.EndAt;var old=Model.Evaluation?.Scores.ToDictionary(x=>x.QuestionId,x=>x);var total=old?.Values.Sum(x=>x.Score)??0;var max=Model.Questions.Sum(x=>x.MaxScore);}
<div class="d-flex justify-content-between align-items-center mb-3"><div><h2>فرم ارزیابی عملکرد</h2><div class="text-muted">@Model.Employee.FullName — @Model.Employee.Position?.Title — دوره @Model.Period.Title</div></div><div class="score-box">@total.ToString("0.##") / @max.ToString("0.##")</div></div>
@if(!editable){<div class="alert alert-warning">بازه ارزیابی پایان یافته است؛ اطلاعات این دوره فقط قابل مشاهده است.</div>}
<form method="post" asp-action="Form"><input type="hidden" name="EmployeeId" value="@Model.Employee.Id"><input type="hidden" name="PositionId" value="@Model.Employee.PositionId"><div class="cardx"><div class="table-responsive"><table class="table"><thead><tr><th>ردیف</th><th>سؤال / شاخص</th><th>سقف</th><th>امتیاز</th><th>توضیحات ارزیاب</th></tr></thead><tbody>@foreach(var q in Model.Questions){var s=old!=null&&old.ContainsKey(q.Id)?old[q.Id]:null;<tr><td>@q.SortOrder</td><td>@q.Text</td><td>@q.MaxScore</td><td style="min-width:130px"><input class="form-control score-input" type="number" step="0.25" min="0" max="@q.MaxScore" name="Scores[@q.Id]" value="@(s?.Score??0)" @(editable?"":"readonly")></td><td><input class="form-control" name="Comments[@q.Id]" value="@s?.Comment" @(editable?"":"readonly")></td></tr>}</tbody></table></div><div class="d-flex justify-content-between align-items-center mt-3"><strong>امتیاز نهایی: <span id="total">@total.ToString("0.##")</span> از @max.ToString("0.##")</strong>@if(editable){<button class="btn btn-main">ثبت و نهایی‌سازی ارزیابی</button>}else{<a class="btn btn-outline-secondary" href="/Evaluation">بازگشت</a>}</div></div></form>
<script>document.querySelectorAll('.score-input').forEach(x=>x.addEventListener('input',()=>{let t=0;document.querySelectorAll('.score-input').forEach(i=>t+=Number(i.value||0));document.getElementById('total').textContent=t.toFixed(2)}));</script>