@model List<Indamin.Performance.Data.OrgUnit>
@{ViewData["Title"]="ساختار سازمانی";}
<div class="mb-3"><h2>ساختار سازمانی</h2><div class="text-muted">هر واحد می‌تواند زیرمجموعه یک واحد بالادست باشد.</div></div><div class="cardx mb-4"><form method="post" action="/Setup/AddOrgUnit" class="row g-2"><div class="col-md-3"><input class="form-control" name="code" placeholder="کد واحد" required></div><div class="col-md-4"><input class="form-control" name="title" placeholder="عنوان واحد" required></div><div class="col-md-3"><select class="form-select" name="parentId"><option value="">واحد بالادست</option>@foreach(var x in Model){<option value="@x.Id">@x.Title</option>}</select></div><div class="col-md-2"><button class="btn btn-main">ثبت واحد</button></div></form></div><div class="cardx"><table class="table"><thead><tr><th>کد</th><th>واحد</th><th>شناسه بالادست</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Code</td><td>@x.Title</td><td>@x.ParentId</td></tr>}</tbody></table></div>