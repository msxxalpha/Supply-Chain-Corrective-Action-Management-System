@model List<Indamin.Performance.Data.Position>
@{ViewData["Title"]="رده‌های پستی و سوالات";}
<h2>رده‌های پستی و سوالات ارزیابی</h2><div class="row g-3"><div class="col-lg-4"><div class="cardx"><h5>رده پستی جدید</h5><form method="post" action="/Setup/AddPosition"><input class="form-control mb-2" name="code" placeholder="کد رده" required><input class="form-control mb-2" name="title" placeholder="عنوان رده" required><input class="form-control mb-2" name="maxScore" value="100" type="number"><button class="btn btn-main">ثبت رده</button></form></div></div><div class="col-lg-8"><div class="cardx"><table class="table"><thead><tr><th>کد</th><th>عنوان</th><th>سقف</th><th>تعداد سوال</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Code</td><td>@p.Title</td><td>@p.MaxScore</td><td>@p.Questions.Count</td></tr>}</tbody></table></div></div></div>