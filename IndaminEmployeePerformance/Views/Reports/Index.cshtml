@model List<Indamin.Performance.Controllers.ReportsController.Row>
@{ViewData["Title"]="گزارش عملکرد";}
<div class="d-flex justify-content-between mb-3"><div><h2>گزارش عملکرد</h2><div class="text-muted">فیلتر، مرتب‌سازی و خروجی Excel</div></div><a class="btn btn-success" href="/Reports/Export">خروجی Excel</a></div>
<div class="cardx"><div class="row g-2 mb-3"><div class="col-md-6"><input class="form-control" data-table-filter="#reportTable" placeholder="فیلتر نام، ارزیاب، واحد یا رده"></div></div><div class="table-responsive"><table id="reportTable" class="table"><thead><tr><th>کارمند</th><th>ارزیاب</th><th>واحد</th><th>رده</th><th>امتیاز</th><th>سقف</th><th>درصد</th><th>وضعیت</th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.Employee</td><td>@x.Evaluator</td><td>@x.Unit</td><td>@x.Position</td><td>@x.Score</td><td>@x.Max</td><td>@(x.Max==0?0:Math.Round(x.Score/x.Max*100,2))</td><td>@x.Status</td></tr>}</tbody></table></div></div>