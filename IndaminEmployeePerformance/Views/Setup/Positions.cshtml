@model List<Indamin.Performance.Data.Position>
@{ViewData["Title"]="رده‌های پستی و سوالات";}
<h2>رده‌های پستی و سوالات ارزیابی</h2><div class="row g-3"><div class="col-lg-4"><div class="cardx"><h5>رده پستی جدید</h5><form method="post" action="/Setup/AddPosition"><input class="form-control mb-2" name="code" placeholder="کد رده" required><input class="form-control mb-2" name="title" placeholder="عنوان رده" required><input class="form-control mb-2" name="maxScore" value="100" type="number"><button class="btn btn-main">ثبت رده</button></form></div></div><div class="col-lg-8"><div class="cardx">@foreach(var p in Model){<div class="border rounded p-3 mb-3"><div class="d-flex justify-content-between"><strong>@p.Title (@p.Code)</strong><span>سقف: @p.MaxScore</span></div><ul class="mt-2">@foreach(var q in p.Questions.OrderBy(x=>x.SortOrder)){<li>@q.SortOrder - @q.Text <span class="text-muted">(@q.MaxScore)</span></li>}</ul><form method="post" action="/Setup/AddQuestion" class="row g-2"><input type="hidden" name="positionId" value="@p.Id"><div class="col-md-7"><input class="form-control" name="text" placeholder="سؤال / شاخص جدید" required></div><div class="col-md-2"><input class="form-control" name="maxScore" placeholder="سقف" type="number" required></div><div class="col-md-2"><input class="form-control" name="sortOrder" placeholder="ترتیب" type="number" value="1"></div><div class="col-md-1"><button class="btn btn-main">+</button></div></form></div>}</div></div></div>