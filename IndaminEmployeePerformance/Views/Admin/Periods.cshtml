@model List<Indamin.Performance.Data.EvaluationPeriod>
@{ViewData["Title"]="دوره‌های ارزیابی";}
<div class="mb-3"><h2>مدیریت دوره‌های ارزیابی</h2><div class="text-muted">تعریف دوره و بازه مجاز ارزیابی ماهیانه</div></div>
<div class="cardx mb-4"><h5>تعریف دوره جدید</h5><form method="post" action="/Admin/CreatePeriod" class="row g-3 mt-1"><div class="col-md-3"><label>عنوان دوره</label><input class="form-control" name="title" placeholder="شهریور ۱۴۰۵" required></div><div class="col-md-3"><label>شروع ارزیابی</label><input class="form-control" name="startJalali" data-jdp placeholder="۱۴۰۵/۰۶/۲۱" required></div><div class="col-md-3"><label>پایان ارزیابی</label><input class="form-control" name="endJalali" data-jdp placeholder="۱۴۰۵/۰۶/۲۵" required></div><div class="col-md-3"><label>توضیحات</label><input class="form-control" name="description"></div><div><button class="btn btn-main">ایجاد دوره</button></div></form></div>
<div class="cardx"><div class="d-flex justify-content-between mb-3"><h5>دوره‌های ثبت‌شده</h5><input class="form-control" style="max-width:280px" data-table-filter="#periodTable" placeholder="جستجو / فیلتر"></div><div class="table-responsive"><table id="periodTable" class="table"><thead><tr><th>دوره</th><th>شروع</th><th>پایان</th><th>وضعیت</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.Title</td><td>@p.StartJalali</td><td>@p.EndJalali</td><td><span class="badge-soft">@(p.IsOpen?"فعال":"بسته")</span></td></tr>}</tbody></table></div></div>